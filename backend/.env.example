# SkillBank Backend Environment Configuration
# Smart India Hackathon (SIH 2026) - MoSPI Problem Statement 101

# Server Settings
PORT=8000
HOST=0.0.0.0

# MongoDB Connection String (e.g. mongodb://localhost:27017 or MongoDB Atlas URI)
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=skillbank_db

# Google Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Google OAuth 2.0 Client ID (Required for login)
GOOGLE_CLIENT_ID=

# Secret key for signing JWT sessions (Must be at least 32 characters long)
# Generate one using: openssl rand -hex 32
SESSION_SECRET=
